# claude-slack-agent configuration
# Copy this file to `.env` (setup.sh does it for you) and fill in the values.
# The listener loads this file automatically at startup.

# ---- REQUIRED --------------------------------------------------------------

# Bot User OAuth token (starts with xoxb-). From your Slack app's
# "OAuth & Permissions" page after installing to workspace.
SLACK_BOT_TOKEN=

# App-Level Token with connections:write scope (starts with xapp-).
# From your Slack app's "Basic Information" -> "App-Level Tokens" section.
# Required because the listener runs in Socket Mode.
SLACK_APP_TOKEN=

# ---- OPTIONAL --------------------------------------------------------------

# Long-lived Claude Code OAuth token. Mint one with:  claude setup-token
# If unset, the `claude` CLI uses whichever login is already configured on the
# host (interactive login, prior setup-token, etc.).
CLAUDE_CODE_OAUTH_TOKEN=

# Default model passed to `claude -p --model`. Any model string the CLI accepts
# is fine (e.g. claude-opus-4-7, claude-sonnet-4-7, claude-haiku-4-7).
DEFAULT_MODEL=claude-opus-4-7

# Model retried once if the default rejects (billing/quota/disabled/etc).
FALLBACK_MODEL=claude-opus-4-7

# Comma-separated Slack channel IDs the bot is allowed to respond in.
# Leave empty to respond wherever the bot is invited (DMs always allowed).
# Example: ALLOWED_CHANNEL_IDS=C01234ABCDE,C0567890XYZ
ALLOWED_CHANNEL_IDS=

# Optional Slack user ID (U...) that gets the "trusted" system prompt (full
# permissions) when DMing the bot. All other users get the restricted prompt.
# Leave empty to treat everyone as restricted.
TRUSTED_USER_ID=

# Working directory used as cwd for each spawned `claude -p` session.
# Defaults to <repo>/workspace (created automatically).
# WORKSPACE_DIR=

# Application log file. Defaults to <repo>/logs/listener.log.
# LOG_FILE=
